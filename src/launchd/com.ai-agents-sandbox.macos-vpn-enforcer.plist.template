<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-agents-sandbox.macos-vpn-enforcer</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>{{SCRIPT_PATH}}</string>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{{HOME}}</string>
        <key>PATH</key>
        <string>{{PATH}}</string>
    </dict>

    <key>StandardOutPath</key>
    <string>{{LOG_DIR}}/macos-vpn-enforcer.log</string>

    <key>StandardErrorPath</key>
    <string>{{LOG_DIR}}/macos-vpn-enforcer.err</string>
</dict>
</plist>
