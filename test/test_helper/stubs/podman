#!/bin/sh
# Fake podman for the testsuite: records the calls and never runs anything.
#   PODMAN_STUB_LOG:         file receiving one line per call (all the
#                            arguments)
#   PODMAN_STUB_RUN_LOG:     file receiving the arguments of 'run', one per
#                            line
#   PODMAN_STUB_BUILD_LOG:   file receiving the arguments of 'build', one per
#                            line
#   PODMAN_STUB_BUILD_CTX:   file receiving the list of the files of the build
#                            context (last argument of 'build'), taken when
#                            'build' is called
#   PODMAN_STUB_BUILD_FAIL:  when set, 'build' fails
#   PODMAN_STUB_IMAGES:      file listing the local images, one per line:
#                            "<repository> <tag> <id>". 'images' prints the
#                            ones matching its 'reference' filter.
#   PODMAN_STUB_IMG_REPO:    repository printed by 'images <name>', the one
#                            of the image 'run' looks at. Default: a local one.
#   PODMAN_STUB_NO_IMAGE:    when set, 'image exists' fails (no local image)
#   PODMAN_STUB_CONTAINERS:  file listing the containers, one per line:
#                            "<name> <state> [<runtime>]". Without it, there
#                            is no container.
#   PODMAN_STUB_FAIL:        space separated commands that fail, e.g.
#                            "run pull start exec". 'build' has its own
#                            PODMAN_STUB_BUILD_FAIL.

if [ -n "${PODMAN_STUB_LOG:-}" ]; then
    printf '%s\n' "$*" >> "${PODMAN_STUB_LOG}"
fi

# Global options given before the command, e.g. --log-level=debug
while :; do
    case "$1" in
        --log-level=*) shift ;;
        *) break ;;
    esac
done

_fails=0
case " ${PODMAN_STUB_FAIL:-} " in
    *" $1 "*) _fails=1 ;;
esac

case "$1" in
    run)
        shift
        if [ -n "${PODMAN_STUB_RUN_LOG:-}" ]; then
            printf '%s\n' "$@" > "${PODMAN_STUB_RUN_LOG}"
        fi
        [ "$_fails" -eq 1 ] && exit 1
        ;;
    build)
        shift
        if [ -n "${PODMAN_STUB_BUILD_LOG:-}" ]; then
            printf '%s\n' "$@" > "${PODMAN_STUB_BUILD_LOG}"
        fi
        if [ -n "${PODMAN_STUB_BUILD_CTX:-}" ]; then
            for _ctx in "$@"; do :; done
            (cd "$_ctx" && find . | sort) > "${PODMAN_STUB_BUILD_CTX}"
        fi
        [ -n "${PODMAN_STUB_BUILD_FAIL:-}" ] && exit 1
        ;;
    container)
        # 'container exists <name>'
        [ -n "${PODMAN_STUB_CONTAINERS:-}" ] || exit 1
        while read -r _name _state _runtime; do
            [ "${_name}" = "$3" ] && exit 0
        done < "${PODMAN_STUB_CONTAINERS}"
        exit 1
        ;;
    inspect)
        # 'inspect <name> --format <template>'
        [ -n "${PODMAN_STUB_CONTAINERS:-}" ] || exit 1
        while read -r _name _state _runtime; do
            [ "${_name}" = "$2" ] || continue
            case "$4" in
                *State.Status*) printf '%s\n' "${_state}" ;;
                *OCIRuntime*)   printf '%s\n' "${_runtime:-runc}" ;;
            esac
            exit 0
        done < "${PODMAN_STUB_CONTAINERS}"
        exit 1
        ;;
    ps)
        # only the listing of the names is faked
        case "$*" in
            *"{{.Names}}"*)
                [ -n "${PODMAN_STUB_CONTAINERS:-}" ] &&
                    while read -r _name _state _runtime; do
                        printf '%s\n' "${_name}"
                    done < "${PODMAN_STUB_CONTAINERS}"
                ;;
        esac
        exit 0
        ;;
    image)
        case "$2" in
            exists) [ -n "${PODMAN_STUB_NO_IMAGE:-}" ] && exit 1 ;;
        esac
        ;;
    pull|start|exec)
        [ "$_fails" -eq 1 ] && exit 1
        ;;
    images)
        case "$2" in
            -*|"") ;;
            *)
                if [ -n "${PODMAN_STUB_IMG_REPO:-}" ]; then
                    printf '%s\n' "${PODMAN_STUB_IMG_REPO}"
                    exit 0
                fi
                ;;
        esac
        if [ -z "${PODMAN_STUB_IMAGES:-}" ]; then
            printf 'localhost/ai-agents-sandbox\n'
            exit 0
        fi
        _ref="*"
        while [ $# -gt 0 ]; do
            case "$1" in
                reference=*) _ref="${1#reference=}" ;;
            esac
            shift
        done
        while read -r _repo _tag _id; do
            # shellcheck disable=SC2254
            case "${_repo}:${_tag}" in
                ${_ref}|*/${_ref}) printf '%s %s\n' "${_repo}" "${_id}" ;;
            esac
        done < "${PODMAN_STUB_IMAGES}"
        ;;
esac
# 'image exists', 'ps', 'volume'...: succeed silently
exit 0
