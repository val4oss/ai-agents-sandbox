{
    "$schema": "https://opencode.ai/config.json",
    "share": "disabled",
    "permission": {
        "bash": "ask",
        "edit": "ask"
    },
    "enabled_providers": ["google","ollama"],
    "plugin": ["opencode-gemini-auth@latest"],
    "provider": {
        "google": {
          "options": {
            "projectId": "{env:GOOGLE_CLOUD_PROJECT}"
          }
        }
    },
    "model": "ollama/default:latest"
}